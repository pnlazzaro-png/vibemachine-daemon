# Vibe Machine daemon. Copy to .env (never committed).
PORT=3005
HOST=127.0.0.1
# Where the SQLite store and the CLI's device key live.
DATA_DIR=~/Library/Application Support/VibeMachine
# CLAUDE_BIN=/opt/homebrew/bin/claude
# Leave empty for Claude Code's own default model.
DEFAULT_MODEL=
# Permission mode for new sessions: default | acceptEdits | plan | bypassPermissions.
# Prompts still come to the phone in default mode.
PERMISSION_MODE=default
# Stop an idle child after this many minutes (it resumes on the next prompt). 0 = never.
IDLE_MINUTES=30
# Serve the phone on this Wi-Fi too, over HTTPS with a certificate the phone
# pins from the pairing QR code (`vibemachine setup` turns it on when Tailscale isn't
# serving the daemon). LAN_PORT is where.
LAN=0
LAN_PORT=3006
# Repos the phone can start a session in (every git repo directly under it).
PROJECTS_DIR=~/dev
# Sessions run the unmodified `claude` binary under the sign-in you made by
# running `claude` yourself; the daemon never sees or stores credentials. To
# bill sessions to an API key instead (Console credits; Max and Team plans
# include some each month), set it here and Claude Code uses it.
# ANTHROPIC_API_KEY=
# The LaunchAgent `vibemachine setup` writes; it reuses an existing *vibemachine.daemon one.
# LAUNCHD_LABEL=com.vibemachine.daemon
# Pushes and the build Live Activity without a key of your own: the push
# relay, which holds one and forwards to Apple (src/pushrelay.ts).
PUSH_RELAY=
# Or directly through APNs with a .p8 key from the
# Apple Developer account (the team's key). Empty = no pushes.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
# The app's bundle id.
APNS_TOPIC=com.pnlazzaro.vibemachine
